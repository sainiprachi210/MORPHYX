{
  "name": "morphyx-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MORPHYX - Professional 3D Open-World Multiplayer Productivity Game",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"web,server\" -c \"cyan.bold,magenta.bold\" \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "npm run dev --workspace=@morphyx/web",
    "dev:server": "npm run dev --workspace=@morphyx/server",
    "build": "npm run build --workspace=@morphyx/shared && npm run build --workspace=@morphyx/server && npm run build --workspace=@morphyx/web",
    "build:shared": "npm run build --workspace=@morphyx/shared",
    "build:web": "npm run build --workspace=@morphyx/shared && npm run build --workspace=@morphyx/web",
    "postinstall": "npm run build --workspace=@morphyx/shared",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
