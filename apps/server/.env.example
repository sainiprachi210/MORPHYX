# MORPHYX Server Configuration Example
# Copy this file to .env and configure your values.
# NEVER commit real .env files or credentials to source control.

# Server runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Logging Level: error, warn, info, debug
LOG_LEVEL=info

# Supabase PostgreSQL Configuration (Required for database operations)
# Retrieve these values from your Supabase Project Settings -> API / Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY is optional for server-side elevated admin operations
SUPABASE_SERVICE_ROLE_KEY=
