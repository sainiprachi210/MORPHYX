# MORPHYX Web Frontend Environment Example
# Copy this file to .env.local to configure local variables.
# NEVER commit real .env files or expose secret keys here.

# Backend API Base URL
VITE_API_URL=http://localhost:4000

# Supabase Public Configuration (ANON KEY ONLY - NEVER expose service-role key!)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
